{
  "name": "@meda/dynamic-ui",
  "version": "1.0.0",
  "description": "Librería moderna para Vue.js que permite crear interfaces CRUD completas usando metadatos del backend. Componentes dinámicos para tablas, modales y formularios.",
  "type": "module",
  "main": "npm/plugins/meda-ui/index.js",
  "files": [
    "npm/plugins/meda-ui/**/*"
  ],
  "exports": {
    ".": {
      "import": "./npm/plugins/meda-ui/index.js"
    },
    "./components/*": "./npm/plugins/meda-ui/components/*",
    "./composables/*": "./npm/plugins/meda-ui/composables/*",
    "./config": "./npm/plugins/meda-ui/config.js"
  },
  "keywords": [
    "vue",
    "vue3",
    "crud",
    "dynamic",
    "table",
    "modal",
    "form",
    "tailwind",
    "laravel",
    "metadata",
    "ui-components"
  ],
  "author": "Meda Team <team@meda.com>",
  "license": "MIT",
  "homepage": "https://github.com/meda/dynamic-ui",
  "repository": {
    "type": "git",
    "url": "https://github.com/meda/dynamic-ui.git"
  },
  "bugs": {
    "url": "https://github.com/meda/dynamic-ui/issues"
  },
  "peerDependencies": {
    "vue": "^3.3.0",
    "@vue/composition-api": "^1.7.0",
    "tailwindcss": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@vue/composition-api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.0.0",
    "@vue/test-utils": "^2.4.0",
    "vitest": "^0.34.0",
    "vue": "^3.3.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}