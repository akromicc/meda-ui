{
  "name": "@meda/dynamic-ui",
  "version": "1.0.0",
  "description": "Librería Vue.js para vistas dinámicas con tablas, paginación y componentes reutilizables",
  "main": "dist/dynamic-ui.umd.js",
  "module": "dist/dynamic-ui.es.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore"
  },
  "keywords": [
    "vue",
    "vue3",
    "dynamic",
    "table",
    "pagination",
    "search",
    "filter",
    "ui",
    "components"
  ],
  "author": "Meda Team",
  "license": "MIT",
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitejs/plugin-vue": "^4.0.0",
    "@vue/compiler-sfc": "^3.0.0",
    "eslint": "^8.0.0",
    "eslint-plugin-vue": "^9.0.0",
    "typescript": "^5.0.0",
    "vite": "^4.0.0",
    "vue-tsc": "^1.0.0"
  },
  "dependencies": {
    "axios": "^1.0.0"
  }
}