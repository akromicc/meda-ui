{
    "name": "meda/dynamic-crud",
    "description": "Librería dinámica para CRUD con paginación, búsqueda y rutas dinámicas",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Meda Team",
            "email": "team@meda.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "laravel/framework": "^10.0|^11.0",
        "illuminate/http": "^10.0|^11.0",
        "illuminate/database": "^10.0|^11.0",
        "illuminate/support": "^10.0|^11.0",
        "carbon/carbon": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "orchestra/testbench": "^8.0|^9.0"
    },
    "autoload": {
        "psr-4": {
            "Meda\\DynamicCrud\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Meda\\DynamicCrud\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Meda\\DynamicCrud\\DynamicCrudServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}